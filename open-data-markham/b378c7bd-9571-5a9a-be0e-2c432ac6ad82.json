  "dct_description_sm": [
    "<div style='text-align:Left;'><div><div><p><span style='font-size:18px;'><span>This data offers a geographic representation of the Senior Safety Zone locations in York Region. The Senior Safety Zone information is maintained in database format by the Traffic Safety team within the Road &amp; Traffic Operations Branch of Public Works.</span></span></p><p><span style='font-size:18px;'><span style='display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>The purpose of this data is to visualize the locations of senior safety zones across York Region.</span></span></p><p><span style='font-size:18px;'><span style='display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>Senior Safety Zones are applied to area in York Region that have a senior facility within close proximity. New zones are considered when new senior facilities are built.</span></span></p></div></div></div>"
