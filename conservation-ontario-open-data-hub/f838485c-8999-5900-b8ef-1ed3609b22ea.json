  "dct_description_sm": [
    "<div><span style='background-color:rgb(255, 255, 255);'><font size='3'><span style='font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif;'><a href='https://metadata.cacore.ca/Details/id=1041' rel='nofollow ugc'>Click here to view metadata</a></span></font></span></div><div><span style='background-color:rgb(255, 255, 255);'><font size='3'><span style='font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif;'><br /></span></font></span></div><div><span style='background-color:rgb(255, 255, 255);'><font size='3'><span style='font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif;'>This dataset was used in the 2018 Watershed Report Cards. The dataset is an&nbsp;</span>amalgamation of all the Conservation Authorities data that participated in the 2018 Watershed Report Cards.<br /></font></span></div><div><span style='background-color:rgb(255, 255, 255);'><font size='3'><br /></font></span></div><span style='background-color:rgb(255, 255, 255);'><font size='3'>Conservation Authorities monitor the quality of groundwater\nusing wells within the Provincial Groundwater Monitoring Network. Samples are\ncollected annually and are analyzed for calcium, magnesium, chloride, sodium,\nnitrogen, phosphorus and metals. Nitrogen and Chloride are used by Conservation Authorities\nas the basis for grading watersheds because they are influenced by human\nactivities.</font></span><div><span style='background-color:rgb(255, 255, 255);'><font size='3'><br /></font></span></div><div><span style='background-color:rgb(255, 255, 255);'><font size='3'>To learn more, please visit&nbsp;&nbsp;<a href='https://www.stateofontariowatersheds.ca/' rel='nofollow ugc' target='_blank'>State of Ontario's Watersheds</a>.</font></span></div>"
