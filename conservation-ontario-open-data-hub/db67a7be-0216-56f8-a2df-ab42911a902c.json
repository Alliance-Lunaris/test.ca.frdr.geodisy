  "dct_description_sm": [
    "<div>Water Quality Data from monthly grab samples collected across the \nToronto and Region Conservation Authority’s (TRCA) jurisdiction. Samples\n are collected monthly following the Provincial Water Quality Monitoring\n Network (PWQMN) protocol and are analyzed at various private and \npartner laboratories. Parameters include nutrients, general chemistry, \nand selected metals.</div><div><br /><br /></div><table><tbody><tr><th>Source</th>\n            \n              <td>TRCA</td>\n            \n          </tr>\n        \n\n        \n          <tr>\n            <th>Author</th>\n            <td><a href='mailto:Jason.tam@trca' rel='nofollow ugc'>Jason Tam</a></td>\n          </tr>\n        \n\n        \n          <tr>\n            <th>Maintainer</th>\n            <td><a href='mailto:Lyndsay.Carwright@trca.ca' rel='nofollow ugc'>Lyndsay Carwright</a></td>\n          </tr>\n        \n\n        \n          <tr>\n            <th><br /></th><td><br /></td></tr></tbody></table>"
