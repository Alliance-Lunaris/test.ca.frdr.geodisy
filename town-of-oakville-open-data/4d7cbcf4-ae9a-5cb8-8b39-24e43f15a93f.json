  "dct_description_sm": [
    "<p><span style='background-color:rgb(255,255,255); color:rgb(74,74,74); font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px;'><span style='display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>North Oakville Zoning By-law 2009-189 is the comprehensive zoning by-law applying to all properties north of Dundas Street and south of Highway 407. It is the rule book controlling how land and buildings are used, the location of buildings on a lot, building heights, and other provisions necessary to ensure proper development. It was created as part of the planning process for North Oakville to implement the North Oakville Secondary Plans. Remaining lands in Oakville are covered by Zoning By-law 2014-014.</span></span></p><p><br /><span style='background-color:rgb(255,255,255); color:rgb(74,74,74); font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px;'><span style='display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>This dataset has been added as an item from ArcGIS Enterprise Zoning feature service (item ID 0be2264d63e042fa8f2fca2745c34550). Note: feature service is used here due to bug with map service image rendering. To try to add as a map service in the future (after Nov 2026 upgrade).</span></span></p>"
