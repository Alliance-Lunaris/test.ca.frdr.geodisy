  "dct_description_sm": [
    "<div style='box-sizing: border-box; position: relative; min-height: 1px; padding-right: 15px; padding-left: 15px; float: left; width: 1170px; color: rgb(51, 51, 51); font-family: Roboto, sans-serif; background-color: rgb(255, 255, 255);'><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 15px;'>The file includes complete election results by voting location, all candidate names and total votes. Also included are the results from fully accessible voting locations and advance voting locations. Voting locations change between elections and cannot be compared.</p><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 15px;'>Notes:<br />There are many locations inside a ward and the electors that live or own property in that ward are free to vote at any location within the same ward.</p><p style='box-sizing: border-box; margin-top: 0px; margin-bottom: 15px;'>To avoid Microsoft Excel from auto-formatting some fields, open the CSV file in notepad for best results.<br /></p></div><div style='box-sizing: border-box; position: relative; min-height: 1px; padding-right: 15px; padding-left: 15px; float: left; width: 1170px; color: rgb(51, 51, 51); font-family: Roboto, sans-serif; background-color: rgb(255, 255, 255);'><div><br /></div></div>"
