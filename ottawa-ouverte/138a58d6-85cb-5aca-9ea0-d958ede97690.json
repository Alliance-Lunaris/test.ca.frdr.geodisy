  "dct_description_sm": [
    "<p></p><p><b><span style='color:black; background:white;'>Synthèse</span></b><span style='color:black; background:white;'> : Affichage des données sur le\ntracé de la voie ferrée de la Ligne 1 de l’O</span><span style='font-family:&quot;Cambria Math&quot;,serif; color:black; background:white;'>‑</span><span style='color:black; background:white;'>Train,\nentre la station </span><span>Tunney’s Pasture et la station Blair.\nLes données portent aussi sur le tracé de la voie ferrée de la cour de triage\nBelfast. <br />\n<br />\n<b><span style='color:black; background:white;'>Exactitude</span></b></span><strong><span style='font-family:&quot;Calibri&quot;,sans-serif; color:#100E0E;'> </span></strong><span style='color:black; background:white;'>: Données à jour;\naucun changement prévu.</span><span> <br />\n<br />\n<b><span style='color:black; background:white;'>Fréquence\nde la mise à jour</span></b></span><strong><span style='font-family:&quot;Calibri&quot;,sans-serif; color:#100E0E;'> : </span></strong><span>Les données sont\nstatiques et sont mises à jour selon les besoins. <br />\n<br />\n<b><span style='color:black; background:white;'>À\nconsulter</span></b></span><strong><span style='font-family:&quot;Calibri&quot;,sans-serif; color:#100E0E;'> : </span></strong><span><a href='mailto:hassan.eljaji@ottawa.ca' rel='nofollow ugc'><span style='background:white;'>Hassan Eljaji</span></a></span></p>"
