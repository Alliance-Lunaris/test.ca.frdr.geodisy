  "dct_description_sm": [
    "<p><span style='color:#4C4C4C; background:white;'>The City’s Adult School Crossing Guard (ASCG)\nprogram helps children safely cross the roadway on their way to and from school.</span><span style='color:#4C4C4C;'><br />\n<br />\n<strong><span style='font-family:&quot;Arial&quot;,sans-serif; background:white;'>Accuracy</span></strong><span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>: The City of Ottawa provides this information in good faith\nbut provides no warranty, nor accepts any liability arising from any incorrect,\nincomplete or misleading information or its improper use.</span></span><br />\n<br />\n<strong><span style='font-family:&quot;Arial&quot;,sans-serif; background:white;'>Update\nFrequency</span></strong><span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>: Annually</span></span><br />\n<br />\n<strong><span style='font-family:&quot;Arial&quot;,sans-serif; background:white;'>Attributes</span></strong><span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>:</span></span><br />\n<br />\n<span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>• Guard Location / Brigadier Placement</span></span><br />\n<br />\n<span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>• Control Type / Type de Contrôle de la Circulation</span></span><br />\n<br />\n<span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>• Number of Guards / Brigadier</span></span><br />\n<br />\n<span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>• X (Longitude)</span></span><br />\n<br />\n<span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>• Y (Latitude)</span></span><br />\n<br />\n<strong><span style='font-family:&quot;Arial&quot;,sans-serif; background:white;'>Contact</span></strong><span style='background:white;'><span style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; text-decoration-style:initial; text-decoration-color:initial; word-spacing:0px;'>:</span></span><br />\n<br />\n</span><span><a href='mailto:Laura.Hagerman@ottawa.ca' rel='nofollow ugc' style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; word-spacing:0px;'><span style='color:#0079C1; background:white; text-decoration:none;'>Laura Hagerman (for questions relating to content)</span></a></span><span style='color:#4C4C4C;'><br />\n<br />\n</span><span><a href='mailto:Zac.brydges@ottawa.ca' rel='nofollow ugc' style='font-variant-ligatures:normal; font-variant-caps:normal; text-align:start; word-spacing:0px;'><span style='color:#0079C1; background:white; text-decoration:none;'>Zac Brydges (for questions relating to data)</span></a></span></p>"
