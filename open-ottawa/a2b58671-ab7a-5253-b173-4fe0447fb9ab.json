  "dct_description_sm": [
    "<div><div style='background-color:rgb(255, 255, 255);'><div><div><div><span style='color:#333333; font-family:source-sans-pro, Arial, sans-serif;'><strong>Summary</strong>: The OC Transpo Live Next Bus Arrival Data Feed API Service provides a gateway into a data feed with real-time OC Transpo bus locations and estimated arrival times for up to the next three buses at a given Stop. Also includes schedule data for O-Train Line 1 departure times.</span></div><div><span style='color:#333333; font-family:source-sans-pro, Arial, sans-serif;'>More details, along with the API Key Application Form, can be found on&nbsp;</span><a target='_blank' href='https://www.octranspo.com/en/plan-your-trip/travel-tools/developers/' rel='nofollow ugc noopener noreferrer'>OC Transpo’s Developer page</a><span style='color:#333333; font-family:source-sans-pro, Arial, sans-serif;'>.</span></div><div><br />&nbsp;</div><div><span style='color:#333333; font-family:source-sans-pro, Arial, sans-serif;'>Note: This is a reference to the OC Transpo Developers API. There is no data to be downloaded on this page.</span></div><div><br />&nbsp;</div><div><span style='color:#333333; font-family:source-sans-pro, Arial, sans-serif;'><strong>Accuracy</strong>: N/A</span></div><div><br />&nbsp;</div><div><span style='color:#333333; font-family:source-sans-pro, Arial, sans-serif;'><strong>Update Frequency</strong>: N/A</span></div><div>&nbsp;</div></div><div style='font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif !important; font-size:17px;'><strong>Contact</strong>:&nbsp;<a style='font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size:15px;' target='_blank' href='https://www.octranspo.com/en/contact-us' rel='nofollow ugc noopener noreferrer'>OC Transpo</a></div></div></div></div>"
