  "dct_description_sm": [
    "<p><span style='mso-bidi-font-family:Arial;\ncolor:#4C4C4C;background:white'>The data sets are annual summaries of the\nuntreated Ottawa River water, the Treated water leaving each drinking water\npurification plant (Britannia and Lemieux Island) plus the Central Distribution\nSystem for each calendar year. These data sets are summaries of selected key\nphysical, chemical, microbiological and radiological parameters. </span><span style='mso-bidi-font-family:Arial;color:#4C4C4C'><br />\n<br />\n<span style='background:white'><span style='font-variant-ligatures: normal;\nfont-variant-caps: normal;orphans: 2;text-align:start;widows: 2;-webkit-text-stroke-width: 0px;\ntext-decoration-style: initial;text-decoration-color: initial;float:none;\nword-spacing:0px'>Full water quality summaries are available online at: </span></span></span><span><a href='http://www.ottawa.ca/en/env_water/water_sewer/water_wells/wells/city_wells/index.html' style='font-variant-ligatures: normal;font-variant-caps: normal;\norphans: 2;text-align:start;widows: 2;-webkit-text-stroke-width: 0px;\nword-spacing:0px' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='mso-bidi-font-family:Arial;color:#0079C1;\nbackground:white'>http://www.ottawa.ca/en/env_water/water_sewer/water_wells/wells/city_wells/index.html</span></a></span><span style='mso-bidi-font-family:Arial;color:#4C4C4C;background:white'><span style='font-variant-ligatures: normal;font-variant-caps: normal;orphans: 2;\ntext-align:start;widows: 2;-webkit-text-stroke-width: 0px;text-decoration-style: initial;\ntext-decoration-color: initial;float:none;word-spacing:0px'>. </span></span><span style='mso-bidi-font-family:Arial;color:#4C4C4C'><br />\n<br />\n<strong><span style='font-family:&quot;Arial&quot;,sans-serif;background:white'>Accuracy</span></strong><span style='background:white'><span style='font-variant-ligatures: normal;\nfont-variant-caps: normal;orphans: 2;text-align:start;widows: 2;-webkit-text-stroke-width: 