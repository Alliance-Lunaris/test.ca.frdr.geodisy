  "dct_description_sm": [
    "<div style='text-align:Left;'><p><span>This dataset provides information regarding the location and attributes of the boulevard trees in the Town of Whitby. This data set does not include information regarding trees in parks or open spaces, just those that fall within the responsibility of Public Works -&nbsp;Asset Management. Tree data is updated by summer students and asset management employees throughout the year, and a consultant is hired once every seven years to do a complete tree inventory.&nbsp;</span></p><p><a target='_blank' href='https://whitby.maps.arcgis.com:443/sharing/rest/content/items/e146fa1d36aa40a89e4853b53451e185/data' rel='nofollow ugc noopener noreferrer'><u>Click here for additional metadata</u></a>.&nbsp;</p><p><span style='font-size:16px;'>Updated December 2025.</span></p></div>"
