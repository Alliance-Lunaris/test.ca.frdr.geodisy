  "dct_description_sm": [
    "<span style='color:rgb(32, 33, 34); font-family:sans-serif; font-size:16px;'>The </span><font color='#000000' face='sans-serif'><span style='text-decoration-style:initial; text-decoration-color:initial; background-position:initial; background-size:initial; background-repeat:initial; background-attachment:initial; background-origin:initial; background-clip:initial; border-radius:2px; font-size:16px;'>Ojibwe<span style='background-color:rgb(255, 255, 255);'> </span></span></font><span style='font-family:sans-serif; font-size:16px;'><font color='#202122'>name for Grand River is </font></span><i><b>Owaashtanong-ziib. </b></i><span style='color:rgb(32, 33, 34); font-family:sans-serif; font-size:16px;'>It lies along the western fringe of the Greater </span><font color='#000000' face='sans-serif'><span style='text-decoration-style:initial; text-decoration-color:initial; background-position:initial; background-size:initial; background-repeat:initial; background-attachment:initial; background-origin:initial; background-clip:initial; border-radius:2px; font-size:16px;'>Golden Horseshoe</span></font><span style='font-family:sans-serif; font-size:16px;'><font color='#000000'> </font><font color='#202122'>region of Ontario From its source near </font></span><font color='#000000' style='text-decoration:none; background-image:none; background-position:initial; background-size:initial; background-repeat:initial; background-attachment:initial; background-origin:initial; background-clip:initial; border-radius:2px; font-family:sans-serif; font-size:16px;'>Wareham, Ontario</font><span style='color:rgb(32, 33, 34); font-family:sans-serif; font-size:16px;'>, it flows south through </span><span style='font-family:&quot;Avenir Next W01&quot;, &quot;Avenir Next W00&quot;, &quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px;'>Haldimand County </span><span style='color:rgb(32, 33, 34); font-family:sans-serif; font-size:16px;'>before emptying into the north shore of </span><font color='#000000' face='sans-serif'><span style='text-decoration-style:initial; text-decoration-color:initial; background-position:initial; background-size:initial; background-repeat:initial; background-attachment:initial; background-origin:initial; background-clip:initial; border-radius:2px; font-size:16px; background-color:rgb(255, 255, 255);'>Lake Erie</span></font><span style='color:rgb(32, 33, 34); font-family:sans-serif; font-size:16px;'> south of </span><font color='#000000' face='sans-serif'><span style='text-decoration-style:initial; text-decoration-color:initial; background-position:initial; background-size:initial; background-repeat:initial; background-attachment:initial; background-origin:initial; background-clip:initial; border-radius:2px; font-size:16px;'>Dunnville</span></font><span style='color:rgb(32, 33, 34); font-family:sans-serif; font-size:16px;'> at </span><font color='#000000'><font face='sans-serif'><span style='text-decoration-style:initial; text-decoration-color:initial; background-position:initial; background-size:initial; background-repeat:initial; background-attachment:initial; background-origin:initial; background-clip:initial; border-radius:2px; font-size:16px;'>Port Maitland</span></font><span style='font-family:sans-serif; font-size:16px;'>.</span></font>"
