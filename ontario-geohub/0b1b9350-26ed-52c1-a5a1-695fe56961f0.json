  "dct_description_sm": [
    "<div><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Many geometrical schemes – or map projections – are used to represent the curved surface of the Earth on map sheets.</span></p><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Canada uses the Universal Transverse Mercator (UTM) system. It is called transverse because the strips run north-south rather than east-west along the equator.This data class shows a 100km x 100km grid coordinate system based on the UTM projection using the North American Datum 83 (NAD83).</span></p><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>It includes:</span></p><p></p><p></p><p></p><ul><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Military Grid Reference</span><br /></li><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Atlas identifier</span><br /></li></ul><p><br /></p></div><div></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span><br /></div><div><ul><li><a href='https://lio.maps.arcgis.com/sharing/rest/content/items/3710a3fedb8345e694fa8dfd8e7b44e6/data' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>UTM Grid - User Guide (Word)</span></a><br /></li><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/UTM%20100%20KM%20Grid%20-%20Data%20Description.pdf' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>UTM 100KM Grid - Data Description (PDF)</span></a></li><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/UTM 100KM Grid - Documentation.docx' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>UTM 100KM Grid - Documentation (Word)</span></a></li></ul><p><br /></p></div><div></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Completed: production of the data has been completed</span><br /></div><div><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>As needed: data is updated as deemed necessary</span><br /></div><div><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Office of the Surveyor General, </span><a href='mailto:landtenuremapping@ontario.ca' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>landtenuremapping@ontario.ca</span></a></div>"
