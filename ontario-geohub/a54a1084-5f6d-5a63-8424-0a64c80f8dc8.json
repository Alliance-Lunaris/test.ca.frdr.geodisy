  "dct_description_sm": [
    "<div><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Federal Land, Other refers to an area of land over which the Federal Crown has exclusive jurisdiction and/or ownership excluding Indian Reserves and Federal Protected Areas. These polygon boundaries should be verified using Federal Crown Land Survey Records and/or title searched at the local Land Registry Office. This data set may not include all Federally owned lands.</span><br /></p></div><div><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span><br /></div><div><ul><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Federal%20Land%20Other%20-%20Data%20Description.pdf' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Federal Land Other - Data Description</span></a><br /></li><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Federal%20Land%20Other%20-%20Documentation.docx' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Federal Land Other - Documentation</span></a><br /></li></ul><p><br /></p></div><div></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>On going: Data is continually being updated</span><br /></div><div><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></spa