  "dct_description_sm": [
    "<span style='text-indent: 0px; float: none; orphans: 2; widows: 2; text-decoration-style: initial; text-decoration-color: initial; display: inline !important;'>\n<div style=''>The spatial record for all the province’s geographic areas affected by provincial level, area-specific land use policy. </div><div style=''> <br /> </div> \n<div style=''>This layer may contain geometry from the:</div>\n<div style=''><ul>\n<li>provincial parks-regulated layer</li>\n<li>conservation reserves-regulated layer</li>\n<li>natural heritage values area layer</li>\n<li> wilderness areas layer</li>\n<li>crown land MNR acquisitions layer</li>\n<li>crown land MNR unpatented layer</li>\n<li>CLUPA geometry (enhanced management areas and general use areas) layer</li>\n</ul></div>\n<div style=''>Not to be used as a source of protected areas (provincial park, conservation reserve, etc.), crown land or private land boundaries.</div><div style=''> <br /> </div> \n<div style=''>Official LIO title: CLUPA Provincial</div>  <div style=''> <br /> </div> \n<div style=''> This class has related tables. <a href='https://geohub.lio.gov.on.ca/datasets?q=RT_CLUPAPRO' target='_blank' rel='nofollow ugc noopener noreferrer'>CLUPA Provincial related tables.</a><br /></div>\n<div style=''> <br /> </div> \n<div style=''> <strong>Additional Documentation<br /> </strong> </div>\n<div style=''><ul>\n<li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/CLUPA%20Provincial%20-%20Data%20Description.pdf' target='_blank' rel='nofollow ugc noopener noreferrer'>CLUPA Provincial - Data Description (PDF)</a></li>\n<li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/CLUPA Provincial - Documentation.docx' target='_blank' rel='nofollow ugc noopener noreferrer'>CLUPA Provincial - Documentation (Word)</a></li>\n\n</ul><br /></div> \n<div style=''></div><div style=''> <strong>Status<br /> </strong> </div>\n<div style=''>On going: data is being continually updated<br /> </div> \n<div style=''> <br /> </div>\n<div style=''> <strong>Maintenance and Update Frequency<br /> </strong> </div>\n<div style=''>Continual: data is repeatedly and frequently updated<br /> </div> \n<div style=''> <br /> </div><div style=''> <strong>Contact<br /> </strong> </div>\n<div style=''>Nicole Mokrey, CLUPA Internet Coordinator, <a href='mailto:nicole.mokrey@ontario.ca' target='_blank' rel='nofollow ugc noopener noreferrer'> nicole.mokrey@ontario.ca</a> </div></span>"
