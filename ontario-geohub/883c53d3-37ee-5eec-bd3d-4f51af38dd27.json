  "dct_description_sm": [
    "<span style='text-indent: 0px; float: none; orphans: 2; widows: 2; text-decoration-style: initial; text-decoration-color: initial; display: inline !important;'>\n\n<div style=''>Natural areas abutting Lake Simcoe are areas of a continuous vegetation community class that have a minimum size of 1 ha and are wholly or partially within the 30 m buffer zone of the Lake Simcoe shoreline. These areas may be a narrow band of vegetation along the shoreline or larger areas, which extend a greater distance from the shoreline. As described in policy 6.31-SA, the MNR and the MOE will map the location of natural areas abutting Lake Simcoe.</div>\n\n\n<div style=''><br /></div>\n\n<div style=''><strong>Status</strong><br /></div>\n\n<div style=''>Completed: Production of the data has been completed<br /></div>\n\n<div style=''><br /></div>\n\n<div style=''><strong>Maintenance and Update Frequency</strong><br /></div>\n\n<div style=''>Not stated<br /></div>\n\n<div style=''><br /></div>\n\n<div style=''><strong>Contact</strong><br /></div>\n\n<div style=''>Emily Funnell, Southern Region, <a href='mailto:Emily.Funnell@ontario.ca' target='_blank'>Emily.Funnell@ontario.ca</a></div></span>"
