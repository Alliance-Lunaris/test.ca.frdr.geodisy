  "dct_description_sm": [
    "<div><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">This dataset is used to:</span></div><div><ul><li><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">assess biodiversity levels</span></li><li><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">define seed zones</span></li><li><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">map ecosystem types</span></li><li><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">set targets for the identification of natural heritage systems</span></li></ul></div><div>&nbsp;</div><div><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\"><strong>Additional Documentation</strong></span><br />&nbsp;</div><div><ul><li><a target=\"_blank\" href=\"https://www.publicdocs.mnr.gov.on.ca/mirb/EcoDistrict - Documentation.docx\"><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">EcoDistrict - Documentation</span></a></li><li><a target=\"_blank\" href=\"https://www.publicdocs.mnr.gov.on.ca/mirb/EcoDistrict - Data Description.pdf\"><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">EcoDistrict - Data Description</span></a></li></ul></div><div>&nbsp;</div><div><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\"><strong>Status</strong></span></div><div><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">Completed: production of the data has been completed</span></div><div>&nbsp;</div><div><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\"><strong>Maintenance and Update Frequency</strong></span><br />&nbsp;</div><div><span style=\"display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;\">As needed: data is updated as deemed necessary</span></div><div>&nbsp;</div><div style=\"background-color:rgb(255, 255, 255); border:0px solid currentcolor; box-sizing:border-box; color:rgb(74, 74, 74); font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; line-height:1.5; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><strong>Contact</strong><br />Calvin Julie, Natural Resources Information Unit</div><div style=\"background-color:rgb(255, 255, 255); border:0px solid currentcolor; box-sizing:border-box; color:rgb(74, 74, 74); font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; line-height:1.5; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><ul><li><a style=\"border:0px solid currentcolor; box-sizing:border-box; color:rgb(0, 97, 155); font-family:inherit; line-height:1.5; text-decoration:none;\" href=\"mailto:calvin.julie@ontario.ca\">calvin.julie@ontario.ca</a></li></ul></div>"
