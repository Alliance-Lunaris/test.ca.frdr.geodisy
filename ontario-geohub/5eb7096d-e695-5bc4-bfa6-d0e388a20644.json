  "dct_description_sm": [
    "<p>French version / Version française: <a target='_blank' href='https://geohub-fr.lio.gov.on.ca/datasets/lio::point-de-perturbation-par-le-feu/about' rel='nofollow ugc noopener noreferrer'>Point de perturbation par le feu | CarrefourGéo Ontario</a></p><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>This dataset shows the locations of ignition points for forest fires of all sizes. Fires that grow larger than 40 hectares are also mapped in the </span><a target='_blank' href='https://www.ontario.ca/data/fire-disturbance-area-firedstb' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Fire Disturbance Area</span></a><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'> dataset.&nbsp;</span><br /><br /><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>The </span><a target='_blank' href='https://www.lioapplications.lrc.gov.on.ca/ForestFireInformationMap/index.html?viewer=FFIM.FFIM' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Forest Fire Info Map</span></a><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'> shows active fires, current fire danger and restricted fire zones in place due to high fire danger.</span></p><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span></div><div><ul><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/Fire%20Disturbance%20Point%20-%20Data%20Description.pdf' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Fire Disturbance Point - Data Description (PDF)</span></a>&nbsp;</li><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/Fire%20Disturbance%20Point%20-%20Documentation.docx' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Fire Disturbance Point - Documentation (Word)</span></a><br />&nbsp;</li></ul><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br /><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>On going: Data is continually being updated</span><br />&nbsp;</p></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Annually: Data is updated every year</span><br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span>&nbsp;</div><div><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Aviation, Forest Fire and Emergency Services</span></p><ul><li><a href='mailto:AFFES.GIS@ontario.ca' rel='nofollow ugc'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>AFFES.GIS@ontario.ca</span></a></li></ul></div>"
