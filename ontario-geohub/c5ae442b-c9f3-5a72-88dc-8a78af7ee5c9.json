  "dct_description_sm": [
    "<div><p><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Landform conservation areas represent areas of significant landform features such as:</span></p><ul><li><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>steep</span></li><li><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>slopes</span></li><li><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>kames</span></li><li><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>kettles</span></li><li><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>ravines</span></li><li><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>ridges</span></li></ul><p>&nbsp;</p><p><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>This dataset identifies Category 1 and Category 2 landform conservation areas as defined in the Oak Ridges Moraine Conservation Plan.</span></p><p><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>For further information on the definition and identification of Landform conservation areas as it relates to the Oak Ridges Moraine Conservation Plan, please refer to the Oak Ridges Moraine Conservation Plan Technical Paper Series: Landform Conservation.</span></p><p><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>All digital information is confined to the Oak Ridges Moraine area.</span></p></div><div><p><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span></p></div><div><ul><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/Landform%20Conservation%20Area%20-%20Data%20Description.pdf' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Landform Conservation Area - Data Description</span></a></li><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/Landform Conservation Area - Documentation.docx' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Landform Conservation Area - Documentation</span></a></li></ul></div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br />&nbsp;</div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>On going: data is being continually updated</span><br />&nbsp;</div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span><br />&nbsp;</div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>As needed: data is updated as deemed necessary</span></div><div>&nbsp;</div><div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></sp