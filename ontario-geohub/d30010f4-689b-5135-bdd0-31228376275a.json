  "dct_description_sm": [
    "<div style='box-sizing:border-box; font-size:16px; color:rgb(26, 26, 26); font-family:&quot;Open Sans&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif;'><p style='box-sizing:border-box; margin-top:0px; margin-bottom:1.5rem; font-size:inherit; line-height:1.6;'><span style='color:rgb(76, 76, 76); font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size:15px;'>This dataset contains a list of engineers that have authored reports under the Drainage Act, 1990. Engineers are appointed by local municipalities to complete drainage projects on behalf of property owners in the watershed.</span></p><p style='box-sizing:border-box; margin-top:0px; margin-bottom:1.5rem; font-size:inherit; line-height:1.6;'><span style='color:rgb(76, 76, 76); font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size:15px;'>This list is maintained by Ontario Ministry of Agriculture, Food and Agribusiness and includes business names, engineers names, addresses, telephone numbers, and company websites.</span></p></div>"
