  "dct_description_sm": [
    "<div><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Municipal Parks are public lands set aside for recreation purposes or to protect natural and cultural environments.</span></p><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>We are no longer updating this data. It is best suited for historical research and analysis</span></p></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span><br /></div><div><ul><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Municipal%20Park%20-%20Data%20Description.pdf' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Municipal Park - Data Description (PDF)</span></a></li><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Municipal Park - Documentation.docx' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Municipal Park - Documentation (Word)</span></a></li></ul></div><div></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Completed: production of the data has been completed</span><br /></div><div><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:in