  "dct_description_sm": [
    "<div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>The spatial accuracy of the lot fabric for some townships has been improved through the Ontario Parcel, Township Realignment and Township Improvement projects. Improvements to the fabric may include:</span></div><div><ul><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>road allowance widths</span></li><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>spatial changes to better represent the location of lot boundaries</span></li><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>more consistent concession names.</span></li></ul></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Data is collected on an on-going basis. The time period “end date” may be more recent than indicated here.</span></div><p><br /></p><div><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span><br /></div><div><ul><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Lot%20Fabric%20Improved%20-%20Data%20Description.pdf' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Lot Fabric Improved - Data Description</span></a></li><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Lot Fabric Improved - Documentation.docx' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Lot Fabric Improved - Documentation</span></a></li><li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Lot%20Fabric%20Improved%20-%20FAQ.pdf' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Lot Fabric Improved - FAQ</span></a></li></ul></div><p><br /></p><div></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>On going: data is being continually updated</span><br /></div><div><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Annually: data is updated every year</span><br /></div><div><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span><br /></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Office of the Surveyor General, </span><a href='mailto:landtenuremapping@ontario.ca' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>landtenuremapping@ontario.ca</span></a></div>"
