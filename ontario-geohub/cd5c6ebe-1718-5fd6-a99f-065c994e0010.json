  "dct_description_sm": [
    "<div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>A Wood Use Area is a polygon feature that identifies an area used to harvest wood for construction material or fuelwood.</span><br />&nbsp;</div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Wood Use Area types collected by the Natural Resources Values Information System are:</span></div><div><ul><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Building Materials Area</span></li><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Fuelwood Area</span></li></ul></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>We are no longer updating this data. It is best suited for historical research and analysis. The data is no longer maintained and future maintenance will not occur.</span><br /><br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Additional Time Period Information: Data is not collected or maintained.</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span><br />&nbsp;</div><div><ul><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/Wood%20Use%20Area%20-%20Data%20Description.pdf' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Wood Use Area - Data Description (PDF)</span></a></li><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/Wood Use Area - Documentation.docx' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Wood Use Area - Documentation (Word)</span></a></li></ul></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Completed: production of the data has been completed</span><br />&nbsp;</div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span><br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Not planned: there are no plans to update the data</span><br />&nbsp;</div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span><br />&nbsp;</div><div>Geospatial Ontario, Ministry of Natural Resources, <a href='mailto:geospatial@ontario.ca' rel='nofollow ugc'>geospatial@ontario.ca</a></div><div>&nbsp;</div><div>The data referenced here is licensed <a target='_blank' href='https://lio.maps.arcgis.com/sharing/rest/content/items/badb097e306b4d3b8becb3dba3ee5807/data' rel='nofollow ugc noopener noreferrer'>Electronic Intellectual Property</a> of the Ontario Ministry of Natural Resources and Forestry and is provided for professional, non-commercial use only.</div>"
