  "dct_description_sm": [
    "<div><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\">Ontario’s recreational fishing regulations are based on 20 Fisheries Management Zones. This map outlines the “border waters area” in Zone 5.</span></div><div><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\">The layer and the resulting map were created by the Office of the Surveyor General of Ontario.</span><br></div><div></div><div><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\"><strong>Additional Documentation</strong></span></div><div><ul><li><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.ontario.ca/document/ontario-fishing-regulations-summary/fisheries-management-zone-5\"><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\">Ontario Fishing Regulations Summary - Fisheries Management Zone 5</span></a><br></li></ul></div><div></div><div><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\"><strong>Status</strong></span><br></div><div><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\">Completed: Production of the data has been completed</span><br></div><div></div><div><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\"><strong>Maintenance and Update Frequency</strong></span><br></div><div><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\">As needed: Data is updated as deemed necessary</span><br></div><div></div><div><span style=\"display:inline !important;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;\"><strong>Contact</stro