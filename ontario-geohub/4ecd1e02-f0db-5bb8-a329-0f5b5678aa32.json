  "dct_description_sm": [
    "<div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>A feature is a representation of a real world object, such as a lake, stream, dam or rapid.</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>There are three hydrographic feature classes: points, lines and polys. All may impede or be hazardous to waterflow and/or navigation on a watercourse or waterbody.</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>This data shows natural and manmade point features. Examples include:</span></div><div><ul><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>waterfalls</span></li><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>rapids</span></li><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>rocks</span></li><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Sea Lamprey barriers</span></li></ul></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span><br />&nbsp;</div><div><ul><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/OHN-User-Guide-EN.docx' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>OHN - User Guide (Word)</span></a></li><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/OHN%20-%20Data%20Capture%20Spec.docx' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>OHN - Data Capture Specification for Hydrographic Features (Word)</span></a></li></ul></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Required: data needs to be generated or updated</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span><br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Not planned: there are no plans to update the data</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Ontario Ministry of Natural Resources - Geospatial Ontario, </span><a href='mailto:geospatial@ontario.ca' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>geospatial@ontario.ca&nbsp;</span></a></div>"
