  "dct_description_sm": [
    "<div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>These signs serve a variety of purposes ranging from providing general information and safety warnings, to enforcement and land management notices to the general public.</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>MNR signs are erected to support and enforce such provincial acts as the:</span></div><div><ul><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Fish and Wildlife Act</span></li><li><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Public Lands Act</span></li></ul></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span></div><div><ul><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/MNR%20Sign%20Site%20-%20User%20Guide.pdf' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>MNR Sign Site - User Guide (PDF)</span></a></li><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/MNR%20Sign%20Site%20-%20Data%20Description.pdf' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>MNR Sign Site - Data Description (PDF)</span></a></li><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/MNR Sign Site - Documentation.docx' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>MNR Sign Site - Documentation (Word)</span></a></li></ul></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>On going: data is being continually updated</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>As needed: data is updated as deemed necessary</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Shawn Mason, Regional IM Specialist</span></div><ul><li><div><a href='mailto:shawn.mason@ontario.ca' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>shawn.mason@ontario.ca</span></a></div></li></ul>"
