  "dct_description_sm": [
    "<div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>The Great Lakes Conservation Blueprint for Biodiversity is comprised of the following products: Aquatic Coarse Filter Scoring Layers, Aquatic Conservation Blueprint, Aquatic Documentation Package, Aquatic Ecological Systems, Aquatic Total Scores Layer, Terrestrial Coarse Filter Scoring Layers, Terrestrial Conservation Blueprint - Southern Ontario and the Canadian Shield, Terrestrial Documentation Package, Terrestrial Ecological Systems and Terrestrial Total Scores Layers.</span></div><div>&nbsp;</div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span></div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Completed: Production of the data has been completed</span></div><div>&nbsp;</div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span></div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>As needed: Data is updated as deemed necessary</span></div><div>&nbsp;</div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span></div><div><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Natural Heritage Information Centre, Science and Research Branch, </span><a href='mailto:NHICRequests@Ontario.ca' rel='nofollow ugc'><span style='display:inline !important; float:none; text-decoration-color:initial; text-decoration-style