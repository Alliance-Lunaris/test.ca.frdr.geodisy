  "dct_description_sm": [
    "<div><p>French version / Version française: <a target='_blank' href='https://geohub-fr.lio.gov.on.ca/datasets/lio::r%C3%A9gions-touch%C3%A9es-par-les-incendies/about' rel='nofollow ugc noopener noreferrer'>Régions touchées par les incendies | CarrefourGéo Ontario</a></p><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>A Fire Disturbance Area represents the mapped exterior perimeter of a forest fire. Mapping is derived from a variety of sources, such as GPS points and digitized paper maps. Prior to 1998, only fires greater than 200 hectares were mapped. Since 1998, fires greater than 40 hectares have been mapped. If adequate mapping exists for fires less than 40 hectares in size, they will be included in this data class.</span></p><p><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>The </span><a target='_blank' href='https://ws.gisetl.lrc.gov.on.ca/ForestFireInformationMap/index.html?viewer=FFIM.FFIM&amp;locale=en-US' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Forest Fire Info Map</span></a><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'> shows active fires, current fire danger and restricted fire zones in place due to high fire danger.&nbsp;</span><br />&nbsp;</p></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Additional Documentation</strong></span></div><div><ul><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/Fire%20Disturbance%20Area%20-%20Data%20Description.pdf' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Fire Disturbance Area - Data Description (PDF)</span></a>&nbsp;</li><li><a target='_blank' href='https://www.publicdocs.mnr.gov.on.ca/mirb/Fire%20Disturbance%20Area%20-%20Documentation.docx' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Fire Disturbance Area - Documentation (Word)</span></a><br />&nbsp;</li></ul></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span><br /><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>On going: Data is continually being updated</span><br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span><br /><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Annually: Data is updated every year</span><br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span><br /><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Aviation, Forest Fire and Emergency Services</span></div><div><ul><li><a href='mailto:AFFES.GIS@ontario.ca' rel='nofollow ugc'><span style='font-family:inherit;'><span style='border:0px solid currentcolor; box-sizing:border-box; display:inline !important; line-height:1.5; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>AFFES.GIS@ontario.ca</span></span></a></li></ul></div>"
