  "dct_description_sm": [
    "<div><div>French version / Version française: <a target='_blank' href='https://geohub-fr.lio.gov.on.ca/documents/d1d202f55b204e04a34a4c9899a37c14/about' rel='nofollow ugc noopener noreferrer'>Types de forêts présentant un risque de feu de végétation | CarrefourGéo Ontario</a></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Hazardous forest types are forested areas identified as having a high to extreme risk of wildland fire. This classification is based on fuels data, including key contributions from the Canadian Forest Service, and is designed to support proactive fire risk assessment and mitigation efforts. The data is intended to guide decision-making around areas that may require further evaluation and should be used in conjunction with best practices and guidance provided by the Ministry of Natural Resources</span></div><div><div>&nbsp;</div><div>The data has been packaged into separate downloads so it can be opened directly in ArcMap, ArcGIS Pro, or QGIS.<br />&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Product Packages</strong></span></div><div><ul><li><a target='_blank' href='https://ws.gisetl.lrc.gov.on.ca/fmedatadownload/Packages/HazardousFuels_ArcMap.zip' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Esri Product Package</span></a></li><li><a target='_blank' href='https://ws.gisetl.lrc.gov.on.ca/fmedatadownload/Packages/HazardousFuels_ArcProLayer.zip' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>ArcGIS Pro Layer Package</span></a></li><li><a target='_blank' href='https://ws.gisetl.lrc.gov.on.ca/fmedatadownload/Packages/HazardousFuels_QGIS.zip' rel='nofollow ugc noopener noreferrer'><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>QGIS Product Package</span></a></li></ul></div></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Status</strong></span></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Not Stated</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Maintenance and Update Frequency</strong></span></div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'>Annually: data is updated every year</span></div><div>&nbsp;</div><div><span style='display:inline !important; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px;'><strong>Contact</strong></span></div><div style='background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(26, 26, 26); font-family:&quot;Open Sans&quot;, &quot;Avenir Next&quot;; font-size:16px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; max-width:100%; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>Aviation, Forest Fire and Emergency Services</div><div style='background-color:rgb(255, 255, 255); box-sizing:border-box; color:rgb(26, 26, 26); font-family:&quot;Open Sans&quot;, &quot;Avenir Next&quot;; font-size:16px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; max-width:100%; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none