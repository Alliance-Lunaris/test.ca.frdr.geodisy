  "dct_description_sm": [
    "<span style='text-indent: 0px; float: none; orphans: 2; widows: 2; text-decoration-style: initial; text-decoration-color: initial; display: inline !important;'>\n<div style=''><p>Site Regions and Site Districts of Ontario represent an early ELC system originally developed by Angus Hills (1959 and later revisions).</div> \n\n<div style=''>This dataset was revised by the ELC Working Group in 2000 to better reflect new information and new technology, while maintaining Hills's original concepts.</div> \n\n<div style=''>For further information on the rationale for the revisions, refer to  Ecoregions of Ontario  Modifications to Angus Hills Site Regions and Districts, Revisions and Rationale (Crins and Uhlig 2000), or the Ecological Land Classification Primer (Crins 2007).</div> \n <div style=''> <br /> </div>\n\n<div style=''> <strong>Additional Documentation<br /></strong><p></p></div><div style=''><ul>\n<li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Site%20Region%20-%20Data%20Description.pdf' target='_blank'>Site Region - Data Description (PDF)</a></li>\n<li><a href='https://www.publicdocs.mnr.gov.on.ca/mirb/Site Region - Documentation.docx' target='_blank'>Site Region - Documentation (Word)</a></li>\n\n</ul></div><br /> <div style=''></div><div style=''> <strong>Status<br /> </strong> </div><div style=''>Completed: production of the data has been completed<br /> </div> <div style=''> <br /> </div><div style=''> <strong>Maintenance and Update Frequency<br /> </strong> </div><div style=''>Not planned: there are no plans to update the data<br /> </div> <div style=''> <br /> </div><div style=''> <strong>Contact<br /> </strong> </div><div style=''>Peter Uhlig,<a href='mailto:Peter.Uhlig@ontario.ca' target='_blank'> Peter.Uhlig@ontario.ca </a> </div></span></p>"
