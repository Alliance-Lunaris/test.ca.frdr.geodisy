  "dct_description_sm": [
    "<p><span style='font-size:12.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#44546A;'>This dataset contains a list of Ontario Farmers Markets, as\nderived from the Farmers Markets of Ontario <a href='https://www.farmersmarketsontario.com/' rel='nofollow ugc'>website</a>.</span></p><p><span style='font-size:12.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#44546A;'>The list includes the name, website and location of farmers\nmarkets in Ontario and it is updated annually or as required throughout the\nyear.</span></p><p><b><span style='font-size:12.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#44546A;'>Ministry contact: </span></b><span style='font-size:12.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#44546A;'><a href='https://www.ontario.ca/feedback/contact-us?id=96579&amp;nid=96570' rel='nofollow ugc'>Agriculture,\nFood and Agribusiness</a></span></p>\n\n<p><br /></p>"
