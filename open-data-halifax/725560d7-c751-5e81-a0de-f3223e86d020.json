  "dct_description_sm": [
    "<p><span style='color:#000000;'>Base layer of street information to be used for civic addressing, emergency service providers and routing requirements.&nbsp;</span></p><p><span style='background-color:rgb(255,255,255); color:#000000; font-family:&quot;Segoe UI&quot;, sans-serif; font-size:16px;'><span style='display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>Due to changes in the dataset, the following fields were renamed: DATE_ACT to Add Date and SYS_DATE to Modified Date. There were also several fields removed from the dataset: FROM_ELEV, TO_ELEV, ACC, SOURCE, Summer Maintenance and Lane Count. The MAINTENANCE field has also been removed, please refer to the OPERATOR field now in </span></span><a target='_blank' href='https://datahrm.hub.arcgis.com/datasets/HRM::ice-routes' rel='nofollow ugc noopener noreferrer'><span style='background-color:rgb(255,255,255); color:#000000; font-family:&quot;Segoe UI&quot;, sans-serif; font-size:16px;'><span style='display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>Ice Routes</span></span></a> <span style='color:#000000;'>for information about &nbsp;on who is responsible for maintaining the street in regards to winter maintenance.</span></p><p><a target='_blank' href='https://hrm.maps.arcgis.com/sharing/rest/content/items/c055814fb5ed4e1cb9a11bb885f72c68/data' rel='nofollow ugc noopener noreferrer'><span>Metadata</span></a></p>"
