  "dct_description_sm": [
    "<p style='margin-bottom:0in;'><span style='font-size:12.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#4C4C4C; background:white;'>This dataset contains all the different possible\ncombinations for employee benefits offered at HRM. The benefits account for all\nposition and employee group combinations. These benefit options include health,\ndental, and income replacement coverage.</span></p>\n\n<p style='margin-bottom:0in; background:white;'><span style='font-size:12.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#4C4C4C;'>This\ndataset is used to support HRM's Benefit Estimate Calculator. This dataset is\nfor estimation only, rates and options are subject to change without notice.\nFor additional information about employment benefits at HRM please visit\nhttps://www.halifax.ca/abouthalifax/ employment/employee-benefits.</span></p>\n\n<p style='margin-bottom:0in; background:white;'><span style='font-size:12.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#4C4C4C;'><a href='https://hrm.maps.arcgis.com/sharing/rest/content/items/f58771c2225f4f1cb54e3ed89a169bfc/data' target='_blank' rel='nofollow ugc noopener noreferrer'><span style='font-family:&quot;inherit&quot;,serif; color:#0079C1;'>Metadata</span></a></span></p>"
