  "dct_description_sm": [
    "<div><span style='display:inline !important; background-color:rgb(255, 255, 255); color:rgb(76, 76, 76); font-family:&quot;Avenir Next W01&quot;,&quot;Avenir Next W00&quot;,&quot;Avenir Next&quot;,&quot;Avenir&quot;,&quot;Helvetica Neue&quot;,sans-serif; font-size:16px; font-style:normal; font-variant:normal; font-weight:400; letter-spacing:normal; text-align:left; text-decoration:none; text-indent:0px; text-transform:none; word-spacing:0px;'>Sewer Manholes are small covered openings in a city street that allow a person to enter the sewer.</span></div><div><font face='Avenir Next W01, Avenir Next W00, Avenir Next, Avenir, Helvetica Neue, sans-serif'><span style='font-size:16px;'>The Sewer Manholes dataset also includes combined wastewater manholes (sewer and storm drain).</span></font></div><div><span style='display:inline !important; background-color:rgb(255, 255, 255); color:rgb(76, 76, 76); font-family:&quot;Avenir Next W01&quot;,&quot;Avenir Next W00&quot;,&quot;Avenir Next&quot;,&quot;Avenir&quot;,&quot;Helvetica Neue&quot;,sans-serif; font-size:16px; font-style:normal; font-variant:normal; font-weight:400; letter-spacing:normal; text-align:left; text-decoration:none; text-indent:0px; text-transform:none; word-spacing:0px;'><br /></span></div><div><font face='Avenir Next W01, Avenir Next W00, Avenir Next, Avenir, Helvetica Neue, sans-serif'><span style='font-size:16px;'>Data are updated by city staff as needed, and automatically copied to the Open Data Portal. The &quot;Last Updated&quot; date shown on our Open Data Portal refers to the last time the data schema was modified in the portal, or any changes were made to this description.  We update our data through automated scripts which does not trigger the &quot;last updated&quot; date to change.</span></font></div><span style='display:inline !important; background-color:rgb(255, 255, 255); color:rgb(76, 76, 76); font-family:&quot;Avenir Next W01&quot;,&quot;Avenir Next W00&quot;,&quot;Avenir Next&quot;,&q