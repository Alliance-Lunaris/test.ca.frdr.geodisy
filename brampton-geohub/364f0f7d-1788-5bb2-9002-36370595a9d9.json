  "dct_description_sm": [
    "<p><span style='background-color:rgb(255,255,255); color:rgb(0,0,0); font-family:inherit; font-size:16px;'><span style='border:0px solid currentcolor; box-sizing:border-box; display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; line-height:1.5; text-align:left; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>Brampton Plan Schedule 12 </span></span><span style='background-color:rgb(255,255,255); color:rgb(0,0,0); font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px;'><span style='border:0px solid currentcolor; box-sizing:border-box; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; line-height:1.5; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>Mature Neighbourhoods mapping delineates </span></span><span style='background-color:rgb(255,255,255); color:rgb(0,0,0); font-family:inherit; font-size:16px;'><span style='border:0px solid currentcolor; box-sizing:border-box; display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; line-height:1.5; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>the land parcels affected by the Mature Neighbourhood By-Law passed by By-Law 280-104 and amended by By-Law 3-2017.</span></span></p><p><span style='background-color:rgb(255,255,255); color:rgb(0,0,0); font-family:inherit; font-size:16px;'><span style='border:0px solid currentcolor; box-sizing:border-box; display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; line-height:1.5; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>Mature Neighbourhoods are established residential areas characterized by their existing development pattern, built form, lot fabric, streetscape, and community character. Development and redevelopment within these areas is intended to be sensitive and compatible with the surrounding neighbourhood context while supporting appropriate evolution over time.</span></span></p><p><span style='background-color:rgb(255,255,255); color:rgb(0,0,0); font-family:inherit; font-size:16px;'><span style='border:0px solid currentcolor; box-sizing:border-box; display:inline !important; float:none; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; line-height:1.5; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;'>This data is intended to be used in conjuction with other related mapping layers for this schedule, and may be impacted by other schedules, with consideration to the text of Brampton Plan.</span></span></p>"
